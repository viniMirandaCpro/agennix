# --- Flask ---
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=troque-esta-chave-em-producao

# --- Banco de dados ---
# Dentro do docker-compose o host e o nome do servico: "db".
# Rodando fora do Docker, use localhost.
DATABASE_URL=postgresql+psycopg2://agennix:agennix@db:5432/agennix

# --- CORS / sessao ---
# Origem do painel Next.js. Precisa ser explicita (sem "*") porque o
# cookie de sessao do Flask-Login viaja com credentials: "include".
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False

# --- Twilio (SMS de confirmacao e lembrete) ---
# Conta de teste: so envia para numeros verificados no console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Lembretes ---
# Antecedencia do lembrete automatico, em horas.
REMINDER_HOURS_BEFORE=2

# --- Testes ---
# Banco separado para o pytest (criar uma vez: docker compose exec db createdb -U agennix agennix_test).
TEST_DATABASE_URL=postgresql+psycopg2://agennix:agennix@db:5432/agennix_test
